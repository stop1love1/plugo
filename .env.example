# ============================================
# Plugo — Secrets Only
# ============================================
# Project configuration is in config.json
# This file contains only API keys and secrets.
# Copy to .env and fill in your values.

# --- Admin Login (REQUIRED — must not be defaults) ---
# The backend refuses to start if these are empty or set to the legacy default "pluginme".
USERNAME=
PASSWORD=

# --- Security ---
# IMPORTANT: Generate a strong random key for production
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# --- Reverse proxy (only needed when something fronts the backend) ---
# The public endpoints are rate limited per client IP, which the backend reads
# from the connection's peer address. Behind nginx/Traefik/a cloud LB that peer
# is the proxy, so every visitor would share one bucket. Set this to the
# proxy's address to have uvicorn trust that hop's X-Forwarded-For instead.
# Leave unset when the backend is exposed directly.
#
# Comma-separated list of LITERAL addresses, e.g. "172.18.0.5" or
# "172.18.0.5,10.0.0.7". Not a CIDR range: uvicorn 0.30.6 matches the peer by
# plain set membership, so "172.18.0.0/16" matches nothing, X-Forwarded-For is
# discarded with no error and no log line, and you get the shared-bucket
# behaviour above while believing you configured your way out of it. On a
# compose network that means pinning the proxy container's address (a static
# IP on a user-defined network) rather than letting Docker assign one.
#
# Do NOT use "*" — that lets any caller forge a client IP past the limits.
FORWARDED_ALLOW_IPS=

# --- MongoDB (only used when config.json → database.provider="mongodb") ---
# Defaults in docker-compose are development-only — change before any deployment.
MONGO_USER=plugo
MONGO_PASSWORD=change-me-before-production

# --- API Keys (fill in the ones you use) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
